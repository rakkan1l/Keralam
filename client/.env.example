# API base URL. Leave empty in development: Vite proxies /api to the server on :5000.
VITE_API_URL=
# Public site URL used for canonical links and Open Graph tags.
VITE_SITE_URL=http://localhost:5173
# Map tiles (OpenStreetMap by default; respect the tile usage policy or use a provider).
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
