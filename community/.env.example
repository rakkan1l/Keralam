# Everything here reaches the browser — never put secrets in VITE_* variables.

# Public brand name. Leave empty until the community name is officially confirmed.
VITE_COMMUNITY_NAME=

# Canonical site URL used for meta tags (e.g. https://example.com).
VITE_SITE_URL=

# Official community links. Leave empty to hide them; never guess these.
VITE_DISCORD_URL=
VITE_YOUTUBE_URL=
VITE_TIKTOK_URL=
VITE_INSTAGRAM_URL=

# Application submission endpoint (the future Express API, e.g. /api/applications).
# While empty, the form validates but clearly states that nothing is sent or stored.
VITE_APPLICATION_ENDPOINT=

# Show clearly labelled development preview entries on the Gangs page.
# Defaults to "true" in `npm run dev` and "false" in production builds.
VITE_GANGS_PREVIEW=
