# ---------------------------------------------------------------
# Kerala Travel & Local Discovery Platform — server configuration
# Copy to server/.env and fill in. Never commit real credentials.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=5000

# MongoDB (local, Docker or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/kerala_travel

# Auth — use a long random string in production (e.g. `openssl rand -hex 48`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Rate limiting (requests per 15 minutes per IP)
RATE_LIMIT_MAX=600

# Admin bootstrap (used by `npm run create-admin`)
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!12345

# ---------- Optional integrations (the app works without them) ----------

# Cloudinary image uploads. Without these, uploads are disabled and admins
# can paste image URLs instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Routing: "osrm" (uses OSRM_URL) or "estimate" (straight-line estimate, clearly labelled)
ROUTING_PROVIDER=estimate
# The public OSRM demo server has a strict fair-use policy; self-host for production.
OSRM_URL=https://router.project-osrm.org

# Weather: "open-meteo" (free, no key) or "none"
WEATHER_PROVIDER=none
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# AI trip builder / assistant. Leave empty to use the labelled demo generator.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
